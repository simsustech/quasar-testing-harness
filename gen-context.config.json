{
  "output": ".github/copilot-instructions.md",

  "outputs": ["copilot", "claude", "gemini"],

  "srcDirs": ["packages", "tests"],

  "exclude": [
    "node_modules", ".git", "dist", "build", "out",
    "__pycache__", ".next", "coverage", "target", "vendor",
    ".context", "playwright-report", "test-results"
  ],

  "maxDepth": 6,

  "maxSigsPerFile": 25,

  "autoMaxTokens": true,

  "coverageTarget": 0.90,

  "modelContextLimit": 128000,

  "maxTokensHeadroom": 0.20,

  "secretScan": true,

  "monorepo": true,

  "diffPriority": true,

  "mcp": {
    "autoRegister": true
  },

  "strategy": "full",

  "hotCommits": 10,

  "depMap": true,

  "todos": true,

  "changes": true,

  "changesCommits": 5,

  "testCoverage": false,

  "impactRadius": false
}
