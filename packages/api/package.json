{
  "name": "@quasar-testing-harness/api",
  "version": "0.1.0",
  "private": true,
  "description": "Fastify SSR host for @quasar-testing-harness/app",
  "type": "module",
  "scripts": {
    "dev": "vitrify dev -m fastify --port 3001",
    "build": "vitrify build -m fastify",
    "start": "node dist/server/server.mjs",
    "lint": "echo 'no lint configured'",
    "format:check": "oxfmt --check .",
    "format:write": "oxfmt --write ."
  },
  "dependencies": {
    "@fastify/middie": "9.3.3",
    "@fastify/static": "10.1.3",
    "@quasar-testing-harness/app": "workspace:*",
    "@quasar-testing-harness/tools": "workspace:*",
    "fastify": "5.11.3"
  },
  "devDependencies": {
    "oxfmt": "^0.63.0",
    "vitrify": "0.26.14"
  }
}
