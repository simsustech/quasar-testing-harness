{
  "name": "@quasar-testing-harness/app",
  "version": "0.1.0",
  "private": true,
  "description": "Quasar Testing Harness - frontend SPA playground",
  "type": "module",
  "exports": {
    "./fastify-ssr-plugin": {
      "import": "./dist/ssr/server/fastify-ssr-plugin.mjs"
    },
    "./hooks": {
      "import": "./dist/ssr/server/virtual_vitrify-hooks.mjs"
    }
  },
  "scripts": {
    "dev": "vitrify dev --host",
    "dev:ssr": "vitrify dev -m ssr",
    "build": "vitrify build -m ssg",
    "build:csr": "vitrify build",
    "build:ssr": "vitrify build -m ssr",
    "build:ssg": "vitrify build -m ssg",
    "minify:csr": "vitrify minify ./dist/csr",
    "minify:ssr:server": "vitrify minify ./dist/ssr/server",
    "minify:ssr:client": "vitrify minify ./dist/ssr/client",
    "minify:ssg": "vitrify minify ./dist/static",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "format:check": "oxfmt --check .",
    "format:write": "oxfmt --write ."
  },
  "dependencies": {
    "@fastify/middie": "9.3.3",
    "@fastify/static": "10.1.3",
    "beasties": "0.4.3",
    "fastify": "5.11.3"
  },
  "devDependencies": {
    "@iconify-json/mdi": "1.2.3",
    "@quasar-testing-harness/api": "workspace:*",
    "@quasar/extras": "2.0.3",
    "@simsustech/quasar-components": "0.12.9",
    "@unocss/preset-icons": "66.7.5",
    "@unocss/preset-wind3": "66.7.5",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/server-renderer": "3.5.41",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "quasar": "2.24.0",
    "typescript": "7.0.2",
    "unocss": "66.7.5",
    "unocss-preset-quasar": "0.5.2",
    "vite": "8.2.1",
    "vitrify": "0.26.14",
    "vue": "3.5.41",
    "vue-router": "5.2.0",
    "vue-tsc": "3.3.9"
  }
}
