{
  "name": "@quasar-testing-harness/app",
  "version": "0.1.0",
  "private": true,
  "description": "Quasar Testing Harness - frontend SPA playground",
  "type": "module",
  "exports": {
    "./fastify-ssr-plugin": {
      "import": "./dist/ssr/server/fastify-ssr-plugin.mjs"
    },
    "./hooks": {
      "import": "./dist/ssr/server/virtual_vitrify-hooks.mjs"
    }
  },
  "scripts": {
    "dev": "vitrify dev --host",
    "dev:ssr": "vitrify dev -m ssr",
    "build": "vitrify build -m ssg",
    "build:csr": "vitrify build",
    "build:ssr": "vitrify build -m ssr",
    "build:ssg": "vitrify build -m ssg",
    "minify:csr": "vitrify minify ./dist/csr",
    "minify:ssr:server": "vitrify minify ./dist/ssr/server",
    "minify:ssr:client": "vitrify minify ./dist/ssr/client",
    "minify:ssg": "vitrify minify ./dist/static",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "format:check": "oxfmt --check .",
    "format:write": "oxfmt --write ."
  },
  "dependencies": {
    "@fastify/middie": "9.3.2",
    "@fastify/static": "9.1.3",
    "beasties": "0.4.2",
    "fastify": "5.8.5"
  },
  "devDependencies": {
    "@iconify-json/mdi": "1.2.3",
    "@quasar-testing-harness/api": "workspace:*",
    "@quasar/extras": "2.0.1",
    "@simsustech/quasar-components": "0.12.4",
    "@unocss/preset-icons": "66.7.2",
    "@unocss/preset-wind3": "66.7.2",
    "@vitejs/plugin-vue": "6.0.7",
    "@vue/server-renderer": "3.5.38",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.69.0",
    "quasar": "2.20.0",
    "typescript": "6.0.3",
    "unocss": "66.7.2",
    "unocss-preset-quasar": "workspace:*",
    "vite": "8.0.16",
    "vitrify": "link:/home/stefan/Projects/vitrify/packages/vitrify",
    "vue": "3.5.38",
    "vue-router": "5.1.0",
    "vue-tsc": "3.3.4"
  }
}
